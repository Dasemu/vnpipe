{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vnpipe/annotation.schema.json",
  "title": "Line annotations",
  "description": "One annotation per parsed line. Produced by LLM sub-agents per chunk, merged and validated by `vnpipe annotate merge`. Enumerations of cast ids and locations are checked against work.toml at merge time.",
  "type": "object",
  "required": ["chunk_id", "input_sha256", "annotations"],
  "additionalProperties": false,
  "properties": {
    "chunk_id": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "annotations": {
      "type": "array",
      "items": {"$ref": "#/$defs/annotation"}
    }
  },
  "$defs": {
    "position": {"enum": ["left", "center", "right"]},
    "annotation": {
      "type": "object",
      "required": ["id", "speaker", "kind", "emotion", "location", "time_of_day", "on_stage"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "speaker": {"type": ["string", "null"], "description": "Cast id; 'narrator' for stage directions, the work's lyric voice id for unattributed verse"},
        "kind": {"enum": ["dialogue", "narration", "stage_direction"]},
        "emotion": {"enum": ["neutral", "joyful", "melancholic", "solemn", "ironic", "angry", "fearful", "ecstatic"]},
        "location": {"type": "string"},
        "time_of_day": {"enum": ["dawn", "day", "dusk", "night", "timeless"]},
        "on_stage": {
          "type": "array",
          "description": "Characters visible (or present) while this line is shown, with stage position",
          "items": {
            "type": "object",
            "required": ["character", "position"],
            "additionalProperties": false,
            "properties": {
              "character": {"type": "string"},
              "position": {"$ref": "#/$defs/position"}
            }
          }
        },
        "music": {"enum": ["contemplative", "comic", "sacred", "ominous", "mystical", "none", null], "description": "Optional music mood; null = keep current"}
      }
    }
  }
}
