{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vnpipe/manifest.schema.json",
  "title": "Asset manifest",
  "type": "object",
  "required": [
    "default_style",
    "styles",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "default_style": {
      "type": "string"
    },
    "styles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "base_prompt",
          "templates"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "description": "Player-facing name of the style"
          },
          "base_prompt": {
            "type": "string"
          },
          "templates": {
            "type": "object",
            "required": [
              "background",
              "sprite",
              "variant"
            ],
            "additionalProperties": {
              "type": "string"
            },
            "description": "Kind-specific prompt templates appended after base_prompt"
          }
        }
      },
      "description": "Art styles keyed by style id"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "prompt",
          "renditions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(bg|sprite)_[a-z0-9_]+$",
            "description": "bg_<location>[_<variant>] or sprite_<character>_<expression>"
          },
          "kind": {
            "enum": [
              "background",
              "sprite"
            ]
          },
          "character": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "description": "Asset-specific prompt; the full prompt sent is the style's base_prompt + kind template + this"
          },
          "reference": {
            "type": [
              "string",
              "null"
            ],
            "description": "Asset id used as reference image (identity consistency)"
          },
          "renditions": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "file",
                "status"
              ],
              "additionalProperties": false,
              "properties": {
                "source": {
                  "enum": [
                    "chatgpt-web",
                    "zenvairo-media",
                    "placeholder",
                    "manual"
                  ]
                },
                "generation_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "raw_file": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Original generated image, relative to the work's assets dir"
                },
                "file": {
                  "type": "string",
                  "description": "Final processed image used by the game, relative to the work's assets dir"
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "status": {
                  "enum": [
                    "planned",
                    "generated",
                    "processed",
                    "approved",
                    "rejected",
                    "placeholder"
                  ]
                },
                "notes": {
                  "type": "string"
                }
              }
            },
            "description": "One image per art style, keyed by style id"
          }
        }
      }
    }
  }
}
